{
  "info": {
    "_postman_id": "8eaef7cf-377e-4137-92c5-a62e7bc07790",
    "name": "Rust-eze v4.1 — HTTPS Website + SDK API (8123)",
    "description": "Full Rust-eze demo. Public static website and dashboard URLs, Fastify SDK API, MySQL, storage and notification sample operations, lifecycle controls and negative tests. Default adminApiKey=booya-admin-key (demonstration only). Change .env ADMIN_API_KEY to this value and restart Rust-eze, or change the collection variable to your real key. The website and collection are public; never use this sample key for a sensitive production API. Run the collection in folder order; disable/enable pairs are adjacent. Host: https://appdevdesign.com:8123. All routes verified against v3.6 source and new collection-download routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
