    {
      "name": "03 MySQL Examples",
      "item": [
        {
          "name": "MySQL: addNote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/execute",
            "description": "Execute mysql.addNote via the SDK plugin registry.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pluginId\": \"mysql\",\n  \"operation\": \"addNote\",\n  \"input\": {\n    \"text\": \"Rust-eze Postman demo: SDK cleaned, database polished!\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Result exists', () => pm.expect(pm.response.json()).to.have.property('result'));",
                  "pm.test('Inserted note has ID', () => pm.expect(pm.response.json().result.id).to.be.a('number'));",
                  "pm.collectionVariables.set('lastNoteId', pm.response.json().result.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "MySQL: listNotes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/execute",
            "description": "Execute mysql.listNotes via the SDK plugin registry.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pluginId\": \"mysql\",\n  \"operation\": \"listNotes\",\n  \"input\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Result exists', () => pm.expect(pm.response.json()).to.have.property('result'));",
                  "pm.test('Notes array', () => pm.expect(pm.response.json().result).to.be.an('array'));"
                ]
              }
            }
