# Optional application settings — database settings live in config/database.env.
# Demo-only credential. Change before using Rust-eze for anything sensitive.
ADMIN_API_KEY=booya-admin-key

# Standalone macOS Node.js HTTPS server
PORT=8123
API_HOST=0.0.0.0
CORS_ORIGIN=https://appdevdesign.com:8123

# Existing Apache TLS file paths are loaded from config/tls.env by scripts/start-macos.sh.
# TLS_CERT_FILE / TLS_KEY_FILE / TLS_CHAIN_FILE may also be set for direct npm execution.
